<!DOCTYPE html>
<html lang="sk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>4ka 5G Internet - FUP Monitor</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background-color: #0f172a; color: #f8fafc; margin: 0; padding: 20px; display: flex; flex-direction: column; align-items: center; min-height: 100vh; }
        .container { width: 100%; max-width: 600px; }
        h1 { font-size: 1.5rem; text-align: center; margin-bottom: 20px; color: #38bdf8; }
        .cards { display: grid; grid-template-columns: 1fr; gap: 15px; margin-bottom: 25px; }
        @media(min-width: 480px) { .cards { grid-template-columns: repeat(3, 1fr); } }
        .card { background: #1e293b; padding: 15px; border-radius: 12px; text-align: center; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.3); }
        .card h3 { margin: 0 0 5px 0; font-size: 0.85rem; color: #94a3b8; text-transform: uppercase; }
        .card p { margin: 0; font-size: 1.4rem; font-weight: bold; color: #f8fafc; }
        .chart-container { background: #1e293b; padding: 20px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.3); position: relative; height: 300px; }
        .footer { margin-top: 15px; font-size: 0.75rem; color: #64748b; text-align: center; }
    </style>
</head>
<body>
    <div class="container">
        <h1>4ka 5G - FUP Monitor</h1>
        <div class="cards">
            <div class="card">
                <h3>Spotrebované</h3>
                <p id="total-val">-- GB</p>
            </div>
            <div class="card">
                <h3>FUP Limit</h3>
                <p>250 GB</p>
            </div>
            <div class="card">
                <h3>Zostáva</h3>
                <p id="left-val">-- GB</p>
            </div>
        </div>
        <div class="chart-container">
            <canvas id="fupChart"></canvas>
        </div>
        <div class="footer" id="timestamp">Naposledy aktualizované: načítavam...</div>
    </div>

    <script>
        async function loadData() {
            try {
                const response = await fetch('data.json?t=' + new Date().getTime());
                if (!response.ok) throw new Error('Dáta nie sú dostupné');
                const data = await response.json();
                
                const total = data.total || 0;
                const limit = 250;
                const left = Math.max(0, limit - total);

                document.getElementById('total-val').innerText = total + ' GB';
                document.getElementById('left-val').innerText = left.toFixed(2) + ' GB';
                document.getElementById('timestamp').innerText = 'Naposledy aktualizované z routera: ' + (data.timestamp || 'Neznáme');

                updateChart(data.labels || ['Dnes'], data.values || [total]);
            } catch (e) {
                console.error('Chyba pri načítaní dát:', e);
            }
        }

        let myChart;
        function updateChart(labels, values) {
            const ctx = document.getElementById('fupChart').getContext('2d');
            if (myChart) myChart.destroy();
            myChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Spotreba (GB)',
                        data: values,
                        backgroundColor: '#38bdf8',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, max: 250, grid: { color: '#334155' }, ticks: { color: '#94a3b8' } },
                        x: { grid: { display: false }, ticks: { color: '#94a3b8' } }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        }

        loadData();
    </script>
</body>
</html>
